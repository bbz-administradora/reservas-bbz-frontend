                      "type": "string",
                      "description": "Mensagem indicando um erro interno no servidor."
                    },
                    "action": {
                      "type": "string",
                      "description": "Ação recomendada para lidar com o erro interno."
                    },
                    "status_code": {
                      "type": "number",
                      "enum": [
                        500
                      ],
                      "description": "Código de status HTTP 500."
                    },
                    "details": {
                      "description": "Detalhes adicionais sobre o erro."
                    }
                  },
                  "required": [
                    "name",
                    "message",
                    "action",
                    "status_code"
                  ],
                  "additionalProperties": false,
                  "description": "Schema to represent Internal Server errors (HTTP 500)"
                }
              }
            }
          }
        }
      }
