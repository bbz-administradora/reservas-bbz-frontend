    "/v1/public/infra/server/health": {
      "get": {
        "operationId": "serverHealthCheck",
        "summary": "Check if the server is healthy",
        "tags": [
          "Infra"
        ],
        "description": "This endpoint performs a simple health check on the server. When a GET request is made to '/v1/public/infra/server/health', the server responds with a 200 status code and a message indicating that it is healthy and operational.\n\nThis endpoint is primarily used for monitoring and testing purposes, such as verifying that the API server is running and responsive. It provides a minimal response structure containing a single message field, making it an ideal solution for automated health checks and system monitoring.",
        "responses": {
          "200": {
            "description": "Server health check",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ],
                  "additionalProperties": false,
                  "description": "Server health check"
                }
              }
            }
