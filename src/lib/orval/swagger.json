    "/v1/private/user/me": {
      "get": {
        "operationId": "userMe",
        "summary": "Get authenticated user data",
        "tags": [
          "User"
        ],
        "description": "This endpoint retrieves the authenticated user's data. The request must include a valid JWT token in the authorization header, which is verified by the 'verifyJWT' middleware.\n\nUpon successful authentication, the system uses the 'getAuthenticatedUser' helper function to extract the user's details from the token's context. The returned data includes the user's unique identifier (UUID), name, nickname, email address, avatar URL, role (adm, user, or dev), any associated licenses, a flag indicating whether a password reset is required, and the current account status.\n\nIf the request is malformed, the JWT is invalid, or access is forbidden, the endpoint responds with appropriate error codes (400, 401, 403, or 500).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "User data successfully retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "name": {
                          "type": "string",
                          "nullable": true
                        },
                        "nickName": {
                          "type": "string",
                          "nullable": true
                        },
                        "email": {
                          "type": "string",
                          "format": "email"
                        },
                        "avatar": {
                          "type": "string",
                          "nullable": true
                        },
                        "role": {
                          "type": "string",
                          "enum": [
                            "admin",
                            "user",
                            "dev"
                          ]
                        },
                        "passwordResetRequired": {
                          "type": "boolean"
                        },
                        "accountStatus": {
                          "type": "boolean"
                        },
                        "phone": {
                          "type": "string",
                          "nullable": true
                        },
                        "calendarAuthorized": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "nickName",
                        "email",
                        "avatar",
                        "role",
                        "passwordResetRequired",
                        "accountStatus",
                        "phone",
                        "calendarAuthorized"
                      ],
                      "additionalProperties": false
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "user",
                    "message"
                  ],
                  "additionalProperties": false,
                  "description": "User data successfully retrieved"
                }
              }
            }
          },
