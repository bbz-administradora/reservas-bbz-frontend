    "/v1/private/auth/refresh/user/session": {
      "patch": {
        "operationId": "refreshUserSession",
        "summary": "Refresh user session",
        "tags": [
          "Auth"
        ],
        "description": "This endpoint refreshes a user's session, updating tokens to maintain secure access without requiring re-login. It validates the current session, checks user identity and device, and then generates new session and refresh tokens, storing the updated session data in the database.\n\nKey features:\n\n - Session and User Validation: Confirms that the user ID in the request matches the session owner and that the session ID and refresh token are valid.\n\n - Device Security: Verifies that the request is from the same device as the original session, enforcing a higher level of security by ensuring tokens are only valid from the initiating device.\n\n - Token Generation: Issues a new sessionToken for immediate authentication and a refreshToken with a 7-day expiration to maintain login persistence.\n\n - Session Update: The database is updated with the new refresh token and session expiration for enhanced session tracking and user experience.\n\nIf successful, the response returns the updated session ID, user ID, and a success message. Any unauthorized requests or device mismatches return appropriate error messages.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Session refreshed with success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "name": {
                          "type": "string",
                          "nullable": true
                        },
                        "nickName": {
                          "type": "string",
                          "nullable": true
                        },
                        "email": {
                          "type": "string",
                          "format": "email"
                        },
                        "avatar": {
                          "type": "string",
                          "nullable": true
                        },
                        "role": {
                          "type": "string",
                          "enum": [
                            "admin",
                            "user",
                            "dev"
                          ]
                        },
                        "passwordResetRequired": {
                          "type": "boolean"
                        },
                        "accountStatus": {
                          "type": "boolean"
                        },
                        "phone": {
                          "type": "string",
                          "nullable": true
                        },
                        "calendarAuthorized": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "nickName",
                        "email",
                        "avatar",
                        "role",
                        "passwordResetRequired",
                        "accountStatus",
                        "phone",
                        "calendarAuthorized"
                      ],
                      "additionalProperties": false
                    },
                    "message": {
                      "type": "string"
                    },
                    "sessionId": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "required": [
                    "user",
                    "message",
                    "sessionId"
                  ],
                  "additionalProperties": false,
                  "description": "Session refreshed with success"
                }
              }
            }
          },
